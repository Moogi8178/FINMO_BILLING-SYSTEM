# Django
SECRET_KEY=change-this-to-a-random-secret-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.up.railway.app
CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# Database - on Railway this is set automatically when you attach a Postgres plugin.
# Leave blank locally to use SQLite instead.
DATABASE_URL=

# M-Pesa Daraja API - get these from https://developer.safaricom.co.ke
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://your-deployed-domain.com/api/mpesa/callback/
